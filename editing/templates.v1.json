  "policy": {
    "strong_effect_cooldown": 2,
    "max_per_10s": {"punch_zoom": 3, "whip_transition": 1, "glitch_burst": 1},
    "never_stack": [["glitch_burst", "subject_popout"], ["whip_transition", "flash_cut"], ["whip_transition", "rgb_split"]]
  }
