{
  "version": 1,
  "effects": {
    "jump_cut_tighten": {"stage": "speech", "duration": [0.12, 0, 1], "params": {"gap": [0.12, 0, 1], "threshold_db": [-50, -80, -25], "keep": [0.06, 0.02, 0.3]}, "sync": "end"},
    "caption_pop": {"stage": "caption", "duration": [0.14, 0.08, 0.4], "params": {"start_scale": [0.86, 0.7, 1], "peak_scale": [1.06, 1, 1.15]}, "sync": "landing"},
    "keyword_highlight": {"stage": "caption", "duration": [0.3, 0.1, 3], "params": {"peak_scale": [1.08, 1, 1.2]}, "sync": "start"},
    "punch_zoom": {"stage": "picture", "duration": [0.2, 0.1, 0.5], "params": {"peak_scale": [1.12, 1, 1.3], "settle_scale": [1.05, 1, 1.2]}, "sync": "impact"},
    "impact_shake": {"stage": "picture", "duration": [0.18, 0.1, 0.4], "params": {"pixels": [14, 0, 28], "rotation": [0.7, 0, 1.5], "frequency": [10, 6, 14]}, "sync": "impact"},
    "flash_cut": {"stage": "overlay", "duration": [0.067, 0.033, 0.134], "params": {"opacity": [0.8, 0, 1]}, "sync": "start"},
    "freeze_frame": {"stage": "picture", "duration": [0.55, 0.1, 1.2], "params": {}, "sync": "start"},
    "broll_cutaway": {"stage": "cutaway", "duration": [1.8, 0.2, 10], "params": {"push": [1, 1, 1.15]}, "sync": "start"},
    "speed_ramp": {"stage": "temporal", "duration": [0.35, 0.2, 1.2], "params": {"peak": [3, 1, 6]}, "sync": "peak_velocity"},
    "whip_transition": {"stage": "transition", "duration": [0.2, 0.12, 0.4], "params": {"blur": [40, 0, 80]}, "sync": "peak_velocity"},
    "focus_reveal": {"stage": "picture", "duration": [0.3, 0.15, 0.8], "params": {"blur": [16, 0, 24]}, "sync": "landing"},
    "callout": {"stage": "overlay", "duration": [1.1, 0.25, 5], "params": {"offset": [40, 0, 100]}, "sync": "landing"},
    "parallax_push": {"stage": "layers", "duration": [1.1, 0.3, 5], "params": {"depth": [0.55, 0, 1]}, "sync": "peak_velocity"},
    "subject_popout": {"stage": "layers", "duration": [0.8, 0.3, 3], "params": {"scale": [1.1, 1, 1.15], "blur": [12, 0, 20], "dim": [0.25, 0, 0.35]}, "sync": "landing"},
    "rgb_split": {"stage": "gpu", "duration": [0.12, 0.067, 0.3], "params": {"offset": [6, 0, 12]}, "sync": "impact"},
    "glitch_burst": {"stage": "gpu", "duration": [0.1, 0.067, 0.3], "params": {"offset": [12, 0, 40], "slices": [8, 4, 16]}, "sync": "impact"}
