        {
          "id": "h1",
          "text": "この大量の水、何のためだと思う？",
          "gap": 0.25
        },
        {
          "id": "h2",
          "text": "実は、ロケットを音から守っている。",
          "gap": 0.16
        }
      ]
    },
    {
      "id": "cause",
      "lines": [
        {
          "id": "c1",
          "text": "発射の瞬間、強烈な音と圧力の波が発生する。",
          "gap": 0.08
        },
        {
          "id": "c2",
          "text": "機体や発射台を傷めるほどのエネルギーだ。",
          "gap": 0.18
        }
      ]
    },
    {
      "id": "answer",
      "lines": [
        {
          "id": "a1",
          "text": "そこで、エンジンの下へ一気に水を流す。",
          "gap": 0.1
        },
        {
          "id": "a2",
          "text": "音のエネルギーを弱めて、機体への負担を減らす。",
          "gap": 0.15
        }
      ]
    },
    {
      "id": "payoff",
      "lines": [
        {
          "id": "p1",
          "text": "この試験では、約百七十万リットル。",
          "gap": 0.12
        },
        {
          "id": "p2",
          "text": "ロケットを守る、水の壁なんだ。",
          "gap": 0.45
        }
      ]
    }
  ],
